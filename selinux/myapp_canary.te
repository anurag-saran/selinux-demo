policy_module(myapp_canary, 1.0.0)

require {
    type myapp_t;
    type myapp_backend_t;
    type init_t;
}

# FCOS / lab fallback when semanage is unavailable — remove overlay at enforce time.
# systemd user units may run in init_t until RHEL semanage path is used.
permissive myapp_t;
permissive myapp_backend_t;
permissive init_t;
