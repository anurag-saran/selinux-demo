policy_module(myapp, 1.0.0)

#############################################
# Staging stub: permissive domain for AVC collection
#############################################

require {
    type init_t;
    class process transition;
    class file entrypoint;
}

type myapp_t;
type myapp_exec_t;
type myapp_var_lib_t;
type myapp_script_exec_t;

files_type(myapp_exec_t)
files_type(myapp_var_lib_t)
files_type(myapp_script_exec_t)

init_daemon_domain(myapp_t, myapp_exec_t)

permissive myapp_t;

allow myapp_t myapp_exec_t:file { execute execute_no_trans read open getattr map };
allow myapp_t myapp_exec_t:dir { search getattr read open };
allow myapp_t myapp_exec_t:lnk_file read;
