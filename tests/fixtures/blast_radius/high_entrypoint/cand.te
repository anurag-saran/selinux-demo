policy_module(myapp, 1.0.0)

type myapp_t;
type myapp_exec_t;
type myapp_var_lib_t;
type myapp_spool_t;

files_type(myapp_var_lib_t)
files_type(myapp_spool_t)

init_daemon_domain(myapp_t, myapp_exec_t)

allow myapp_t self:process signal;
allow myapp_t myapp_spool_t:dir { search write add_name remove_name };
type_transition myapp_t myapp_spool_t:file myapp_spool_t;
