[Unit]
Description=Order Processor backend stub (Tier 6 outbound/Unix demo)
Documentation=file:///opt/myapp/backend_stub.py
After=network.target

[Service]
Type=simple
# Exec the labeled script so init_t -> myapp_backend_t (venv python stays in myapp_t).
ExecStart=/opt/myapp/backend_stub.py
User=myapp
Group=myapp
WorkingDirectory=/opt/myapp
Environment=MYAPP_NOTIFY_SOCK=/run/myapp/notify.sock
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=myapp
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=mixed

# NoNewPrivileges blocks SELinux type_transition (init_t -> myapp_backend_t) on RHEL.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /opt/myapp must be writable for Python imports (__pycache__) and readable under ProtectSystem=strict.
ReadWritePaths=/opt/myapp /run/myapp

[Install]
WantedBy=multi-user.target
