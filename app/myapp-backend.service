[Unit]
Description=Order Processor backend stub (Tier 6 outbound/Unix demo)
Documentation=file:///opt/myapp/backend_stub.py
After=network.target

[Service]
Type=simple
ExecStartPre=+/bin/rm -f /var/myapp/notify.sock
ExecStart=/opt/myapp/backend_stub.py
User=myapp
Group=myapp
WorkingDirectory=/opt/myapp
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
