[Unit]
Description=Order Processor App (SELinux Policy-as-Code reference)
Documentation=file:///opt/myapp/app.py
After=network.target auditd.service myapp-backend.service
Wants=auditd.service myapp-backend.service

[Service]
Type=simple
User=myapp
Group=myapp
WorkingDirectory=/opt/myapp
ExecStart=/opt/myapp/venv/bin/python /opt/myapp/app.py
Environment=FLASK_ENV=production
Restart=on-failure
RestartSec=5

StateDirectory=myapp
LogsDirectory=myapp
RuntimeDirectory=myapp
RuntimeDirectoryPreserve=yes
# NoNewPrivileges blocks SELinux type_transition (init_t -> myapp_t) on RHEL.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/myapp /var/lib/myapp /run/myapp /var/log/myapp /var/spool/myapp

# venv python is labeled myapp_exec_t so init_t -> myapp_t.

[Install]
WantedBy=multi-user.target
