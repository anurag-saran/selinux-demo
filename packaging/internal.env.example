# Copy to packaging/internal.env (gitignored) on the controller.
# Production shops do not pull compile images from Docker Hub.

# Internal registry mirror of the Stream 9 selinux-policy-devel image.
SELINUX_BUILD_IMAGE=registry.example.internal/security/selinux-build:stream9
SELINUX_BUILD_IMAGE_PULL=1

# Directory served by httpd / Pulp / Satellite as a yum repo.
SELINUX_RPM_REPO=/var/www/html/selinux-pac

# GPG key name in the admin's rpm macros (~/.rpmmacros %_gpg_name).
SELINUX_GPG_NAME=selinux-pac
