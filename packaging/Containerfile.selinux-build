# Pre-baked compile image for RHEL 9 policy ABI (refpolicy Makefile).
#
# Default: CentOS Stream 9 (RHEL 9 upstream; selinux-policy-devel in AppStream).
# Optional subscribed base: SELINUX_BUILD_BASE_IMAGE=registry.redhat.io/rhel9/rhel:9.4
#
# Build:  bash scripts/build_selinux_compile_image.sh
# Publish: DOCKERHUB_TOKEN=… bash scripts/publish_selinux_compile_image.sh
ARG BASE_IMAGE=quay.io/centos/centos:stream9
FROM ${BASE_IMAGE}

RUN dnf install -y -q \
    selinux-policy-devel \
    checkpolicy \
    policycoreutils \
    setools-console \
    selinux-policy-targeted \
    && dnf clean all

WORKDIR /build
